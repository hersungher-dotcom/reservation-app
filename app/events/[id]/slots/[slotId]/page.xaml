import { notFound } from 'next/navigation';
import BookingForm from '@/components/booking-form';
import { useEffect, useState } from 'react';
import { supabase } from '@/lib/supabase';
import type { Event, EventSlot, Reservation } from '@/types';

export const generateStaticParams = async () => {
  // In a real app, you'd fetch all event and slot IDs
  return [];
};

export default function SlotBookingPage({
  params,
}: {
  params: { id: string; slotId: string };
}) {
  const [event, setEvent] = useState<Event | null>(null);
  const [slot, setSlot] = useState<EventSlot | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [isBooking, setIsBooking] = useState(false);
  const [bookingSuccess, setBookingSuccess] = useState(false);

  useEffect(() => {
    fetchEvent();
    fetchSlot();
  }, [params.id, params.slotId]);

  async function fetchEvent() {
    try {
      const { data, error } = await supabase
        .from('events')
        .select('*')
        .eq('id', params.id)
        .single();

      if (error) throw error;
      if (!data) {
        notFound();
        return;
      }
      setEvent(data);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Erreur inconnue');
    } finally {
      setLoading(false);
    }
  }

  async function fetchSlot() {
    try {
      const { data, error } = await supabase
        .from('event_slots')
        .select('*')
        .eq('id', params.slotId)
        .single();

      if (error) throw error;
      if (!data) {
        notFound();
        return;
      }
      setSlot(data);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Erreur inconnue');
    }
  }

  async function handleBooking(formData: { name: string; email: string }) {
    if (!event || !slot) return;

    setIsBooking(true);
    try {
      // First, get the current user session
      const {
        data: { session },
      } = await supabase.auth.getSession();

      if (!session) {
        // Redirect to sign-in if not authenticated
        window.location.href = '/';
        return;
      }

      // Create the reservation
      const { error } = await supabase.from('reservations').insert({
        event_id: event.id,
        event_slot_id: slot.id,
        user_id: session.user.id,
        status: 'confirmed',
      });

      if (error) throw error;

      setBookingSuccess(true);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Erreur de réservation');
    } finally {
      setIsBooking(false);
    }
  }

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-background">
        <div className="text-center">
          <div className="inline-block animate-spin rounded-full border-4 border-primary border-t-transparent"></div>
          <p className="mt-4 text-sm text-muted-foreground">Chargement des détails...</p>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-background">
        <div className="text-center">
          <h2 className="text-xl font-semibold text-destructive mb-4">
            Erreur
          </h2>
          <p className="text-muted-foreground">{error}</p>
        </div>
      </div>
    );
  }

  if (!event || !slot) {
    notFound();
    return null;
  }

  if (bookingSuccess) {
    return (
      <div className="min-h-screen bg-background flex items-center justify-center">
        <div className="text-center py-12">
          <div className="inline-block w-16 h-16 bg-success/20 text-success rounded-full flex items-center justify-center mb-4">
            ✓
          </div>
          <h2 className="text-2xl font-bold text-success mb-4">
            Réservation confirmée !
          </h2>
          <p className="text-lg text-muted-foreground mb-6">
            Vous avez réservé votre place pour :
          </p>
          <div className="bg-background rounded-lg p-6 mb-6">
            <p className="font-medium text-foreground">
              {event.title}
            </p>
            <p className="text-sm text-muted-foreground">
              {new Date(slot.start_time).toLocaleDateString()} à {
                new Date(slot.start_time).toLocaleTimeString([], {
                  hour: '2-digit',
                  minute: '2-digit',
                )}
              } -
              {new Date(slot.end_time).toLocaleTimeString([], {
                hour: '2-digit',
                minute: '2-digit',
              })}
            </p>
          </div>
          <Link
            href="/reservations"
            className="inline-flex items-center px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90"
          >
            Voir mes réservations
          </Link>
        </div>
      </div>
    );
  }

  const startTime = new Date(slot.start_time);
  const endTime = new Date(slot.end_time);

  return (
    <main className="min-h-screen bg-background">
      <div className="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 py-12">
        <nav className="flex items-center justify-between mb-6">
          <Link href={`/events/${event.id}`} className="text-sm text-muted-foreground hover:text-primary">
            ← Retour à l'événement
          </Link>
          <h1 className="text-xl font-bold text-foreground">
            {event.title}
          </h1>
        </nav>

        <div className="mb-8">
          <p className="text-lg text-muted-foreground">
            {startTime.toLocaleDateString()} à {
              startTime.toLocaleTimeString([], {
                hour: '2-digit',
                minute: '2-digit',
              })
            } -
            {endTime.toLocaleTimeString([], {
              hour: '2-digit',
              minute: '2-digit',
            })}
          </p>
          {event.location && (
            <p className="text-sm text-muted-foreground mt-1">
              {event.location}
            </p>
          )}
        </div>

        <BookingForm
          eventTitle={event.title}
          slotStartTime={slot.start_time}
          slotEndTime={slot.end_time}
          onSubmit={handleBooking}
          isLoading={isBooking}
        />
      </div>
    </main>
  );
}
